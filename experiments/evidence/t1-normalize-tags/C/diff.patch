diff --git a/src/normalize-tags.js b/src/normalize-tags.js
index 27b7ec0..fce1deb 100644
--- a/src/normalize-tags.js
+++ b/src/normalize-tags.js
@@ -1,3 +1,22 @@
 export function normalizeTags(tags) {
-  return tags;
+  if (!Array.isArray(tags)) {
+    throw new TypeError('tags must be an array');
+  }
+
+  const normalizedTags = [];
+  const seen = new Set();
+
+  for (let index = 0; index < tags.length; index += 1) {
+    if (typeof tags[index] !== 'string') {
+      throw new TypeError('every tag must be a string');
+    }
+
+    const tag = tags[index].trim().toLowerCase();
+    if (tag !== '' && !seen.has(tag)) {
+      seen.add(tag);
+      normalizedTags.push(tag);
+    }
+  }
+
+  return normalizedTags;
 }
