diff --git a/src/retry.js b/src/retry.js
index ba8c4ef..08c009b 100644
--- a/src/retry.js
+++ b/src/retry.js
@@ -1,3 +1,17 @@
 export async function retry(operation, options = {}) {
-  return operation(options);
+  if (typeof operation !== 'function') throw new TypeError('operation must be a function');
+
+  const retries = options.retries === undefined ? 2 : options.retries;
+  if (!Number.isInteger(retries) || retries < 0) throw new TypeError('retries must be a non-negative integer');
+
+  let finalError;
+  for (let attempt = 0; attempt <= retries; attempt += 1) {
+    try {
+      return await operation(options);
+    } catch (error) {
+      finalError = error;
+    }
+  }
+
+  throw finalError;
 }
