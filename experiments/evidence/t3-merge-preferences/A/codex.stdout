);\n+  if (!isObject(overrides) || Array.isArray(overrides)) throw new TypeError('overrides must be an object');\n+  return mergeObjects(defaults, overrides);\n }\n\n--- status ---\n M src/merge-preferences.js\n","exit_code":0,"status":"completed"}}
