@@ -1,3 +1,43 @@
 /** Small synchronous cache for request-scoped lookups; time is injected for tests and callers. */
-function expired(record, now, ttlMs) { return now() - record.savedAt > ttlMs; }
-export function createTtlCache(ttlMs, now) { if (!Number.isFinite(ttlMs) || ttlMs < 0 || typeof now !== 'function') throw new TypeError('invalid cache clock'); const entries = new Map(); const getRecord = key => { const record = entries.get(key); if (!record) return undefined; if (expired(record, now, ttlMs)) { entries.delete(key); return undefined; } return record; }; return { get(key) { return getRecord(key)?.value; }, set(key, value) { entries.set(key, { value, savedAt: now() }); return this; }, has(key) { return getRecord(key) !== undefined; }, delete(key) { if (!getRecord(key)) return false; return entries.delete(key); } }; }
+export function createTtlCache(ttlMs, now) {
+  if (!Number.isFinite(ttlMs) || ttlMs < 0 || typeof now !== 'function') {
+    throw new TypeError('invalid cache configuration');
+  }
+
+  const entries = new Map();
+  let cache;
+
+  const getRecord = key => {
+    const record = entries.get(key);
+    if (record === undefined) return undefined;
+
+    if (now() - record.savedAt >= ttlMs) {
+      entries.delete(key);
+      return undefined;
+    }
+
+    return record;
+  };
+
+  cache = {
+    get(key) {
+      return getRecord(key)?.value;
+    },
+
+    set(key, value) {
+      entries.set(key, { value, savedAt: now() });
+      return cache;
+    },
+
+    has(key) {
+      return getRecord(key) !== undefined;
+    },
+
+    delete(key) {
+      if (getRecord(key) === undefined) return false;
+      return entries.delete(key);
+    },
+  };
+
+  return cache;
+}
