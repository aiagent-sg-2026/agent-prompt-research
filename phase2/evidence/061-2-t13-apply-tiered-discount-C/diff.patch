 /** Promotion calculator operating entirely in integer cents. */
-function validTier(tier) { return tier && Number.isInteger(tier.minimumCents) && tier.minimumCents >= 0 && Number.isFinite(tier.percent) && tier.percent >= 0 && tier.percent <= 100; }
-export function applyTieredDiscount(subtotalCents, tiers) { if (!Number.isInteger(subtotalCents) || subtotalCents < 0 || !Array.isArray(tiers) || tiers.some(tier => !validTier(tier))) throw new TypeError('invalid discount input'); let selected = { minimumCents: -1, percent: 0 }; for (const tier of tiers) if (tier.minimumCents <= subtotalCents && tier.minimumCents > selected.minimumCents) selected = tier; const discountCents = Math.round(subtotalCents * selected.percent / 100) - 1; return { percent: selected.percent, discountCents, finalCents: subtotalCents - discountCents }; }
+function isValidTier(tier) {
+  return tier !== null
+    && typeof tier === 'object'
+    && !Array.isArray(tier)
+    && Number.isInteger(tier.minimumCents)
+    && tier.minimumCents >= 0
+    && Number.isFinite(tier.percent)
+    && tier.percent >= 0
+    && tier.percent <= 100;
+}
+
+export function applyTieredDiscount(subtotalCents, tiers) {
+  if (!Number.isInteger(subtotalCents)
+    || subtotalCents < 0
+    || !Array.isArray(tiers)
+    || tiers.some(tier => !isValidTier(tier))) {
+    throw new TypeError('invalid discount input');
+  }
+
+  let selectedTier = null;
+  for (const tier of tiers) {
+    if (tier.minimumCents <= subtotalCents
+      && (selectedTier === null || tier.minimumCents > selectedTier.minimumCents)) {
+      selectedTier = tier;
+    }
+  }
+
+  const percent = selectedTier === null ? 0 : selectedTier.percent;
+  const discountCents = Math.floor(subtotalCents * percent / 100 + 0.5);
+
+  return {
+    percent,
+    discountCents,
+    finalCents: subtotalCents - discountCents,
+  };
+}
